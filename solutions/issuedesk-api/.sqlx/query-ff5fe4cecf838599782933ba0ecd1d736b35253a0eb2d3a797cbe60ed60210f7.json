{
  "db_name": "PostgreSQL",
  "query": "SELECT g.id, g.name, g.description, g.created_by,\n                  COUNT(gm.user_id) as \"member_count!\",\n                  g.created_at, g.updated_at\n           FROM groups g\n           LEFT JOIN group_members gm ON gm.group_id = g.id\n           GROUP BY g.id\n           ORDER BY g.name",
