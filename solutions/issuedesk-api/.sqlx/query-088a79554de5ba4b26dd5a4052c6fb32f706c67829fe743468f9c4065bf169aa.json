  "query": "SELECT u.id as user_id, u.user_name, u.display_name, u.email,\n                  u.role, gm.added_at\n           FROM group_members gm\n           JOIN users u ON u.id = gm.user_id\n           WHERE gm.group_id = $1\n           ORDER BY u.display_name",
